[Unit]
Description=llama.cpp CPU LLM Server (gemma4-e2b)
After=network.target

[Service]
Type=forking
Environment=LD_LIBRARY_PATH=%h/local-llm-lab/repo/build/bin
WorkingDirectory=%h/local-llm-lab
PIDFile=%h/local-llm-lab/run/server.8888.pid
ExecStart=%h/local-llm-lab/serve_cpu.sh gemma4-e2b 8888
ExecStop=%h/local-llm-lab/stop.sh 8888
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/local-llm-lab/run/server.8888.log
StandardError=append:%h/local-llm-lab/run/server.8888.log

[Install]
WantedBy=default.target
